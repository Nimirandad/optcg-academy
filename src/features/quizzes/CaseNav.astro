---
import { withBase } from '../../lib/paths';
interface Props {
  groups: { level: number; name: string; cases: unknown[] }[];
  active?: number;
}
const { groups, active } = Astro.props;
---
<nav aria-label="Niveles de casos">
  {groups.map(({ level, name, cases }) => (
    <a href={withBase(`casos/${level}/`)} aria-current={active === level ? 'page' : undefined}>
      <strong>Nivel {level} · {name}</strong><span>{cases.length} {cases.length === 1 ? 'caso' : 'casos'}</span>
    </a>
  ))}
</nav>
<style>
  nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 0.65rem; margin-block: 1rem; }
  a { display: grid; min-height: 44px; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.7rem; background: var(--surface); text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  a:hover, a:focus-visible { transform: translateY(-3px); box-shadow: var(--shadow); }
  a[aria-current] { border: 2px solid var(--link); }
  span { color: var(--muted); font-size: 0.85rem; }
</style>
