---
import Icon from './Icon.astro';
import { withBase } from '../../lib/paths';
import { sections } from '../../lib/sections';

const current = Astro.url.pathname;
---
<header>
  <div class="container bar">
    <a class="brand" href={withBase('')} aria-label="Inicio de OPTCG Academy">
      <img src={withBase('arte/marca-optcg-academy.png')} width="510" height="216" alt="" />
    </a>
    <nav id="main-nav" aria-label="Principal">
      <ul>
        {sections.map((section, index) => {
          const href = withBase(section.path);
          return <li style={`--item: ${index}`}><a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>{section.label}</a></li>;
        })}
      </ul>
    </nav>
    <div class="actions">
      <a class="control" href={withBase('buscar/')} aria-label="Buscar" title="Buscar"><span><Icon name="search" /></span></a>
      <button class="control js-only" type="button" id="theme-toggle" aria-pressed="false" aria-label="Modo oscuro" title="Modo oscuro"><span class="moon"><Icon name="moon" /></span><span class="sun"><Icon name="sun" /></span></button>
      <button class="control js-only menu-button" type="button" id="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Menú" title="Menú"><span class="menu-icon"><Icon name="menu" /></span><span class="close-icon"><Icon name="close" /></span></button>
    </div>
  </div>
</header>

<style>
  header {
    background: radial-gradient(ellipse at 10% 0%, rgb(95 180 162 / 0.11), transparent 60%), var(--header-bg);
    color: var(--header-text);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 55%, var(--header-bg));
    font-family: 'Avenir Next', 'Segoe UI', system-ui, sans-serif;
  }
  .bar {
    width: min(100% - 2rem, 85rem);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'brand nav actions';
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.65rem;
  }
  a { color: var(--header-text); text-decoration: none; }
  .brand, .control, nav a { display: inline-flex; align-items: center; min-height: 44px; }
  .brand { grid-area: brand; border-radius: 0.5rem; }
  .brand img {
    display: block; width: 8rem; height: auto;
    transition: transform 260ms cubic-bezier(.2,.8,.3,1.3), filter 260ms ease;
  }
  .brand:is(:hover, :focus-visible) img {
    transform: translateY(-2px) rotate(-3deg);
    filter: drop-shadow(0 0 0.45rem rgb(239 199 125 / 0.28));
  }
  .actions { grid-area: actions; justify-self: end; display: flex; gap: 0.4rem; }
  .control {
    justify-content: center;
    width: 44px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 65%, var(--header-bg));
    border-radius: 50%;
    background: transparent;
    color: var(--header-text);
    font: inherit;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, transform 220ms cubic-bezier(.2,.8,.3,1.3);
  }
  .control:is(:hover, :focus-visible) { background: rgb(255 255 255 / 0.1); transform: translateY(-2px); }
  .control:active { transform: scale(0.92); }
  .control[aria-pressed='true'], .control[aria-expanded='true'] { background: var(--accent); color: var(--header-bg); }
  .control span { display: inline-flex; }
  .control .sun, .control[aria-pressed='true'] .moon,
  .control .close-icon, .control[aria-expanded='true'] .menu-icon { display: none; }
  .control[aria-pressed='true'] .sun, .control[aria-expanded='true'] .close-icon {
    display: inline-flex;
    animation: icon-in 240ms cubic-bezier(.2,.8,.3,1.3) both;
  }
  :global(html:not(.js)) .js-only, .menu-button { display: none; }

  nav { grid-area: nav; }
  ul { display: flex; justify-content: center; gap: 0.125rem; list-style: none; margin: 0; padding: 0; }
  nav a {
    position: relative; justify-content: center; padding-inline: 0.5rem;
    font-size: 0.875rem; font-weight: 650; line-height: 1.25; white-space: nowrap;
    border-radius: 0.55rem;
    transition: background 200ms ease, color 200ms ease;
  }
  nav a::after {
    position: absolute; content: ''; inset-inline: 0.5rem; bottom: 0.3rem; height: 2px;
    border-radius: 1rem; background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform 240ms cubic-bezier(.2,.8,.3,1);
  }
  nav a:is(:hover, :focus-visible, [aria-current='page']) {
    color: var(--accent);
    background: rgb(239 199 125 / 0.08);
  }
  nav a:is(:hover, :focus-visible, [aria-current='page'])::after { transform: scaleX(1); }

  @keyframes icon-in { from { opacity: 0; transform: rotate(-35deg) scale(0.65); } }
  @keyframes nav-in { from { opacity: 0; transform: translateY(-0.45rem); } }
  @media (56rem < width <= 68rem) {
    .bar { gap: 0.6rem; }
    nav a { font-size: 0.8rem; padding-inline: 0.32rem; }
    nav a::after { inset-inline: 0.32rem; }
  }
  @media (max-width: 56rem) {
    .bar { grid-template-columns: 1fr auto; grid-template-areas: 'brand actions' 'nav nav'; column-gap: 0.5rem; row-gap: 0; }
    .brand { justify-self: start; }
    :global(html.js) .menu-button { display: inline-flex; }
    :global(html.js) nav:not([data-open]) { display: none; }
    nav { margin-top: 0.65rem; padding: 0.45rem; border: 1px solid rgb(239 199 125 / 0.25); border-radius: 0.85rem; background: rgb(0 0 0 / 0.12); }
    nav[data-open] { animation: nav-in 220ms ease-out both; }
    nav[data-open] li { animation: nav-in 220ms ease-out both; animation-delay: calc(var(--item) * 22ms); }
    ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); gap: 0.2rem; }
    nav a { width: 100%; justify-content: flex-start; white-space: normal; padding-inline: 0.65rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand:is(:hover, :focus-visible) img, .control:is(:hover, :focus-visible, :active) { transform: none; }
  }
</style>

<script>
  import { nextTheme, THEME_KEY, type Theme } from '../../lib/theme';

  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const menuButton = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const nav = document.querySelector<HTMLElement>('#main-nav');

  const current = (): Theme => (root.dataset.theme === 'dark' ? 'dark' : 'light');
  const sync = () => themeButton?.setAttribute('aria-pressed', String(current() === 'dark'));

  themeButton?.addEventListener('click', () => {
    const theme = nextTheme(current());
    root.dataset.theme = theme;
    sync();
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // Sin almacenamiento disponible: el cambio dura solo esta página.
    }
  });
  sync();

  const setMenu = (open: boolean) => {
    menuButton?.setAttribute('aria-expanded', String(open));
    nav?.toggleAttribute('data-open', open);
  };
  const compact = matchMedia('(max-width: 56rem)');
  compact.addEventListener('change', (event) => {
    const focused = document.activeElement;
    if (event.matches && nav?.contains(focused) && menuButton?.getAttribute('aria-expanded') !== 'true') {
      menuButton?.focus();
    }
    if (!event.matches && focused === menuButton) nav?.querySelector('a')?.focus();
    if (!event.matches) setMenu(false);
  });

  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') !== 'true';
    setMenu(open);
    if (open) nav?.querySelector('a')?.focus({ preventScroll: true });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>
