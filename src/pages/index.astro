---
import { getCollection } from 'astro:content';
import VoyageMap from '../features/voyage/VoyageMap.svelte';
import Base from '../layouts/Base.astro';
import { islandsOf } from '../features/voyage/islands';
import { sortLessons } from '../lib/academy';
import { inventory } from '../lib/inventory';
import { withBase } from '../lib/paths';

const lessons = sortLessons(await getCollection('lessons'));
const islands = islandsOf(lessons);
const extras = [
  { path: 'simuladores/', label: 'Simuladores', text: 'Practica libremente' },
  { path: 'reglas/', label: 'Reglas', text: 'Resuelve una duda' },
  { path: 'glosario/', label: 'Glosario', text: '¿Qué significa?' },
  { path: 'mazos/', label: 'Mazos', text: 'Encuentra tu color' },
  { path: 'casos/', label: 'Casos y desafíos', text: 'Resuelve situaciones' },
  { path: 'qa/', label: 'Q&A', text: 'Aclaraciones oficiales' },
  { path: 'actualizaciones/', label: 'Actualizaciones', text: 'Estado de las fuentes' },
];
---
<Base title="OPTCG Academy" description="Plataforma educativa no oficial de ONE PIECE Card Game en español.">
  <section class="hero">
    <div class="words">
      <h1>Zarpa hacia tu primera partida</h1>
      <p>Aprende ONE PIECE Card Game en español, paso a paso y jugando.</p>
      <p class="buttons">
        <a class="main" href={withBase('jugar/')}>Prueba un combate</a>
        <a href="#mapa">Ver el recorrido</a>
      </p>
    </div>
    <img class="scene" src={withBase('arte/travesia.webp')} srcset={`${withBase('arte/travesia-720.webp')} 720w, ${withBase('arte/travesia.webp')} 1440w`} sizes="(max-width: 44rem) calc(100vw - 2rem), 34rem" width="1440" height="960" alt="" fetchpriority="high" />
  </section>

  <section class="map" id="mapa" aria-labelledby="mapa-titulo">
    <h2 id="mapa-titulo">Tu recorrido</h2>
    <p>Cinco islas, de lo más simple a lo avanzado. Tu avance se guarda en este navegador.</p>
    <VoyageMap {islands} client:load />
  </section>

  <h2>Cuando ya estés a bordo</h2>
  <ul class="extras">
    {extras.map((extra) => (
      <li><a href={withBase(extra.path)}><strong>{extra.label}</strong><span>{extra.text}</span></a></li>
    ))}
  </ul>

  <h2>Estado de actualización</h2>
  <p class="notice">
    Sitio en construcción. Reglamento de referencia: versión {inventory.source.version}, fechada el {inventory.source.lastUpdated} y comparada con el PDF oficial el 2026-11-26. Todavía no hay sincronización automática.
  </p>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: stretch; overflow: hidden; border-radius: var(--panel-radius); background: var(--sea); color: #fff; box-shadow: var(--shadow); }
  .words { align-self: center; padding: clamp(1.2rem, 4vw, 3rem); }
  h1 { font-size: clamp(2.35rem, 5vw, 4.3rem); margin: 0; line-height: 0.99; }
  .words p { font-size: 1.1rem; }
  .buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.25rem; }
  .buttons a { display: inline-flex; align-items: center; min-height: 48px; padding: 0.45rem 1rem; border-radius: 0.5rem; border: 1px solid var(--accent); color: #fff; font-weight: 750; text-decoration: none; }
  .buttons .main { background: var(--sun); color: var(--sun-text); }
  .buttons a:hover { box-shadow: inset 0 0 0 1px var(--accent); }
  .hero :focus-visible, .map :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .scene { display: block; width: 100%; height: 100%; min-height: 22rem; object-fit: cover; object-position: 55% center; }
  .map { margin-top: 2rem; border-radius: var(--panel-radius); padding: 1rem clamp(0.75rem, 4vw, 2rem) 2rem; background: var(--sea); color: #fff; }
  @media (max-width: 44rem) {
    .hero { grid-template-columns: 1fr; }
    .scene { height: auto; min-height: 0; aspect-ratio: 3 / 2; }
  }
  .map h2 { font-size: 1.75rem; margin-bottom: 0; }
  .extras { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: 0.75rem; list-style: none; padding: 0; }
  .extras a { display: flex; flex-direction: column; min-height: 44px; padding: 0.75rem 1rem; border: 2px solid var(--border); border-radius: 1rem; background: var(--surface); text-decoration: none; transition: transform 0.2s; }
  .extras a:hover { transform: translateY(-3px); border-color: var(--link); }
  .extras span { color: var(--muted); }
</style>
