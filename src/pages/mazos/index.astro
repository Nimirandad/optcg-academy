---
import CardCatalog from '../../features/recommender/CardCatalog.astro';
import PreferenceTest from '../../features/recommender/PreferenceTest.svelte';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';

const rule = (id: string) => withBase(`reglas/${id.split('-')[0]}/#regla-${id}`);
---
<Base title="Mazos" description="Elige un color, explora un Starter Deck y prueba el test de preferencias.">
  <h1>Mazos</h1>
  <p class="notice">Para torneos, confirma el formato vigente con Bandai.</p>

  <CardCatalog />

  <h3>Cartas multicolor</h3>
  <p>
    Una carta puede tener varios colores y cuenta como carta de cada uno (<a href={rule('2-3-5')}>2-3-5</a>). El mazo se
    construye según los colores del Leader (<a href={rule('5-1-2-2')}>5-1-2-2</a>).
  </p>

  <h2 id="test">Test de preferencias</h2>
  <PreferenceTest client:visible />
  <noscript><p>El test necesita JavaScript.</p></noscript>
</Base>
