---
import { getCollection } from 'astro:content';
import VoyageMap from '../../features/voyage/VoyageMap.svelte';
import { islandsOf } from '../../features/voyage/islands';
import Base from '../../layouts/Base.astro';
import { sortLessons } from '../../lib/academy';

const lessons = sortLessons(await getCollection('lessons'));
---
<Base title="Aprende" description="Elige una isla para explorar sus lecciones de ONE PIECE Card Game.">
  <h1>Aprende</h1>
  <p>Elige una isla para ver sus lecciones.</p>
  <div class="map"><VoyageMap islands={islandsOf(lessons)} client:load /></div>
</Base>

<style>
  .map { border-radius: 1.5rem; padding: 1.5rem clamp(0.65rem, 4vw, 2rem); background: radial-gradient(circle at 20% 10%, #205865, #102b35 70%); color: white; }
</style>
