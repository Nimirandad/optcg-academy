---
import { getCollection } from 'astro:content';
import Icon from '../../components/ui/Icon.astro';
import Emblem from '../../features/art/Emblem.svelte';
import Base from '../../layouts/Base.astro';
import { chapters } from '../../lib/chapters';
import { inventory } from '../../lib/inventory';
import { withBase } from '../../lib/paths';

const topics = (await getCollection('topics')).map((entry) => entry.data).sort((a, b) => a.order - b.order);
---
<Base title="Reglas" description="Las reglas de ONE PIECE Card Game por temas y por número.">
  <h1>Reglas</h1>
  <p>
    Consulta las explicaciones por tema o busca una regla por número.
  </p>
  <ul class="topics">
    {topics.map((topic) => (
      <li>
        <a href={withBase(`reglas/tema/${topic.id}/`)}>
          <span class="icon" aria-hidden="true"><Emblem name={`tema-${topic.icon}`} /></span>
          <strong>{topic.question}</strong>
          <span>{topic.title} · {topic.steps.length} pasos</span>
        </a>
      </li>
    ))}
  </ul>

  <header class="reference">
    <h2>Referencia numerada</h2>
    <a href={withBase('buscar/')}>Buscar un número <Icon name="search" /></a>
  </header>
  <ol class="chapters">
    {chapters.map((chapter) => (
      <li><a href={withBase(`reglas/${chapter.number}/`)}><span class="chapter-number">{chapter.number}</span><strong lang="en">{chapter.title}</strong><Icon name="arrow" /></a></li>
    ))}
  </ol>
  <p>Fuente: <a href="https://en.onepiece-cardgame.com/rules/">reglamento oficial</a>, versión {inventory.source.version}.</p>
</Base>

<style>
  .topics { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: 1rem; list-style: none; padding: 0; }
  .topics a { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; height: 100%; padding: 1.25rem 1rem; text-align: center; text-decoration: none; border-radius: 1.25rem; border: 2px solid #8fb4d4; background: var(--sea); color: #fff; box-shadow: var(--shadow); transition: transform 0.25s; }
  .topics a:hover, .topics a:focus-visible { transform: translateY(-0.4rem) rotate(-0.6deg); outline: 3px solid var(--link); outline-offset: 2px; }
  .icon { width: 4rem; height: 4rem; color: #ffe08a; transition: transform 0.4s; }
  a:hover .icon { transform: scale(1.15) rotate(6deg); }
  .topics strong { font-size: 1.25rem; line-height: 1.25; }
  .reference { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline; justify-content: space-between; }
  .reference a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; }
  .chapters { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 0.65rem; padding: 0; list-style: none; }
  .chapters a { display: flex; align-items: center; gap: 0.55rem; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 0.7rem; min-height: 56px; padding: 0.45rem 0.55rem; height: 100%; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  .chapters a:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .chapters :global(svg) { margin-inline-start: auto; }
  .chapter-number { display: grid; place-items: center; flex: 0 0 2rem; height: 2rem; border-radius: 0.35rem; background: var(--sea); color: white; font-weight: 800; }
</style>
