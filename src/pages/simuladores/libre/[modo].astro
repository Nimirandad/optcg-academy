---
import CombatSim from '../../../features/battle/CombatSim.svelte';
import EffectsSim from '../../../features/effects/EffectsSim.svelte';
import Playmat from '../../../features/playmat/Playmat.svelte';
import TurnSim from '../../../features/turns/TurnSim.svelte';
import SimulatorNav from '../../../features/shared/SimulatorNav.astro';
import Base from '../../../layouts/Base.astro';
import '../../../features/shared/sim.css';

export function getStaticPaths() {
  return [
    { params: { modo: 'combate' }, props: { title: 'Combate', text: 'Elige el atacante y toca al objetivo. Después decide si bloquear o usar Counter.' } },
    { params: { modo: 'turnos' }, props: { title: 'Turnos', text: 'Avanza por cada fase con cartas reales y una mesa preparada.' } },
    { params: { modo: 'playmat' }, props: { title: 'Playmat', text: 'Juega cartas reales en una mesa preparada. Los efectos impresos quedan fuera de este ejercicio.' } },
    { params: { modo: 'efectos' }, props: { title: 'Efectos', text: 'Prueba costes y orden de resolución. Las cartas didácticas de esta mesa aíslan cada efecto.' } },
  ];
}

const { title, text } = Astro.props;
const mode = Astro.params.modo;
const base = import.meta.env.BASE_URL;
---
<Base title={title} description={text}>
  <h1>{title}</h1>
  <SimulatorNav active={mode} />
  <p>{text}</p>
  <noscript><p>El simulador necesita JavaScript.</p></noscript>
  <section aria-label={title}>
    {mode === 'combate' && <CombatSim {base} client:load />}
    {mode === 'turnos' && <TurnSim {base} client:load />}
    {mode === 'playmat' && <Playmat {base} client:load />}
    {mode === 'efectos' && <EffectsSim {base} client:load />}
  </section>
</Base>
