{
  "name": "optcg-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "node scripts/coverage/validate.ts",
    "sync": "node scripts/sync/run.ts",
    "validate:decks": "node scripts/validate/decks.ts",
    "review-sheet": "node scripts/coverage/review-sheet.ts",
    "test:e2e": "playwright test",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/svelte": "9.1.6",
    "astro": "7.4.13",
    "svelte": "5.59.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.2",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "pagefind": "1.6.0",
    "svelte-eslint-parser": "1.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
